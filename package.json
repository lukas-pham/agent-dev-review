{
  "name": "agent-dev-review",
  "private": true,
  "type": "module",
  "description": "Two isolated agents: Develop (requirement -> branch) and Review (independent, evidence-based verdict).",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "start": "tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "tsx src/benchmark.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
